@model IEnumerable<NgoDonationManagement.Models.Donation>
<section class="page-head"><div><span class="eyebrow">Operations</span><h1>Donation records</h1></div><a class="button" href="/Donations/Create">Add record</a></section>@if (TempData["Notice"] is not null) { <div class="notice">@TempData["Notice"]</div> }<form class="filters" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search by name"><select name="status"><option value="">All statuses</option><option>Active</option><option>Pending</option><option>Archived</option></select><button class="button" type="submit">Filter</button></form><div class="table-wrap"><table><thead><tr><th>Name</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong><br><small>@item.Description</small></td><td><span class="status">@item.Status</span></td><td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><a href="/Donations/Edit/@item.Id">Edit</a> · <a href="/Donations/Delete/@item.Id">Delete</a></td></tr> }</tbody></table></div>